# Copy to .env to override settings locally. Every entry is optional.
# Values set in the shell take precedence over this file.

# Tracking store and model registry. Defaults to the SQLite file in config/config.yaml.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Directory for MLflow artefacts when a local tracking store is used
# FRAUDGUARD_MLFLOW_ARTIFACT_DIR=mlartifacts

# Alternative configuration file
# FRAUDGUARD_CONFIG_PATH=config/config.yaml

# Log level for the scripts and the API
# FRAUDGUARD_LOG_LEVEL=INFO

# Interface and port for the API
# FRAUDGUARD_API_HOST=127.0.0.1
# FRAUDGUARD_API_PORT=8000

# File that receives one JSON line per prediction
# FRAUDGUARD_PREDICTION_LOG_PATH=data/monitoring/predictions.jsonl

# Model bundle written by scripts/export_model.py. When set, the API loads the model
# from it instead of the registry.
# FRAUDGUARD_MODEL_BUNDLE=dist/model_bundle
